# Connection details for the prod -> staging clone scripts.
# Copy to .env.db (gitignored) and fill in. Never commit the real file.
#
# Use the SESSION POOLER connection strings from:
#   Supabase Dashboard -> your project -> Connect -> Session pooler
# Both projects live in eu-west-1, so the host below is already correct; only the
# password needs filling in.
# The direct `db.<ref>.supabase.co` host is IPv6-only on newer projects, and these
# scripts run pg_dump/psql inside Docker, which generally cannot reach it.
#
# The password must be percent-encoded (e.g. `@` -> %40, `#` -> %23).

# --- production (read from, never written to) ---
PROD_DB_URL=postgresql://postgres.lvlsdfceyzizjibpwoiu:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
PROD_PROJECT_REF=lvlsdfceyzizjibpwoiu

# --- staging (wiped and rewritten on every clone) ---
STAGING_DB_URL=postgresql://postgres.STAGINGREF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
STAGING_PROJECT_REF=STAGINGREF

# --- storage file copy (npm run db:copy-storage) ---
PROD_SUPABASE_URL=https://lvlsdfceyzizjibpwoiu.supabase.co
PROD_SERVICE_ROLE_KEY=
STAGING_SUPABASE_URL=https://STAGINGREF.supabase.co
STAGING_SERVICE_ROLE_KEY=
