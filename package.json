{
  "name": "beachamp-training",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test src/lib/merch/*.test.ts src/lib/nav/*.test.ts src/lib/king-of-court/*.test.ts src/lib/badges/*.test.ts src/lib/share/*.test.ts src/lib/utils/*.test.ts src/lib/coach-pay/*.test.ts src/lib/birthdays/*.test.ts src/lib/auth/*.test.ts src/lib/coaches/*.test.ts src/lib/attendance/*.test.ts src/lib/scheduling/*.test.ts src/lib/payments/*.test.ts src/lib/private-sessions/*.test.ts",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/types/database.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:clone": "./scripts/db/clone-prod-to-staging.sh",
    "db:copy-storage": "tsx scripts/db/copy-storage.ts",
    "db:password": "./scripts/db/set-db-password.sh",
    "env": "./scripts/db/use-env.sh",
    "env:staging": "./scripts/db/use-env.sh staging",
    "env:prod": "./scripts/db/use-env.sh prod"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.49.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "nodemailer": "^8.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^2.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
